ANTHROPIC_API_KEY=your_api_key_here

# claude-haiku-4-5 for dev (cheap), claude-opus-4-8 for prod (accurate)
PARSER_MODEL=claude-haiku-4-5

# ── Database ──────────────────────────────────────────────────────────────────
# Local (docker-compose): use values below as-is
# Production: replace with RDS / Supabase / Neon connection string
DATABASE_URL=postgresql+asyncpg://itr:itr_local@localhost:5432/itr_filing

# ── S3 / File storage ─────────────────────────────────────────────────────────
# Local (docker-compose MinIO): use values below as-is
# Production: remove S3_ENDPOINT_URL; set real AWS credentials
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=itr-filings
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=ap-south-1

# ── Authentication ────────────────────────────────────────────────────────────
# Generate strong random strings for production:  openssl rand -hex 32
JWT_SECRET=local-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

NEXTAUTH_SECRET=local-dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000
