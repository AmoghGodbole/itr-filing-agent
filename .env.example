ANTHROPIC_API_KEY=your-anthropic-api-key-here

# claude-haiku-4-5 for dev (cheap), claude-opus-4-8 for prod (accurate)
PARSER_MODEL=claude-haiku-4-5

# ── Database ──────────────────────────────────────────────────────────────────
# Local: copy these values into .env as-is (docker-compose reads them too)
# Production: replace with your RDS / Supabase / Neon connection string
POSTGRES_PASSWORD=choose-a-local-password
DATABASE_URL=postgresql+asyncpg://itr:choose-a-local-password@localhost:5432/itr_filing

# ── S3 / File storage ─────────────────────────────────────────────────────────
# Local: MinIO (runs in docker-compose); use any username/password you like
# Production: remove S3_ENDPOINT_URL; set real IAM credentials from AWS console
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=itr-filings
MINIO_ROOT_USER=choose-a-local-username
MINIO_ROOT_PASSWORD=choose-a-local-password
AWS_ACCESS_KEY_ID=same-as-minio-root-user
AWS_SECRET_ACCESS_KEY=same-as-minio-root-password
AWS_REGION=ap-south-1

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32
NEXTAUTH_URL=http://localhost:3000

# ── Seed script ───────────────────────────────────────────────────────────────
# Password used for all seed users (local dev only)
SEED_USER_PASSWORD=choose-a-dev-password
